WEB_ADDR=:8080
MCP_ADDR=:8081
DATA_FILE=./data/collections.jsonl

COLLECT_TOKEN=replace-with-a-long-random-collection-token
MCP_TOKEN=replace-with-a-different-long-random-mcp-token
MCP_ALLOWED_ORIGINS=

OIDC_ISSUER_URL=https://identity.example.com/realms/connect
OIDC_CLIENT_ID=connect-dashboard
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
OIDC_REDIRECT_URL=https://connect.example.com/oidc/callback

# Set both to serve HTTPS directly. Leave both empty behind a TLS reverse proxy.
TLS_CERT_FILE=
TLS_KEY_FILE=
